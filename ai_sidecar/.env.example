# Copy to .env and fill in values:
#   copy .env.example .env
#
# Get a key: https://cursor.com/dashboard/integrations
# Never commit .env (it is gitignored).
#
# IMPORTANT: replace the whole value with your real key in one line.
#   Good:  CURSOR_API_KEY=cursor_xxxxxxxx
#   Bad:   CURSOR_API_KEY=cursor_your_...api_key_here   (placeholder leftover)

CURSOR_API_KEY=cursor_xxxxxxxx

# 1 = mock mode (no Cursor call; picks Stockfish candidate #1)
AI_SIDECAR_MOCK=0

# Optional
CURSOR_AI_MODEL=composer-2.5
# AI_SIDECAR_WORKDIR=

# Gate demo only: treat this UCI as the model's answer on every /move,
# so the candidate gate visibly replaces it. Leave unset for real play.
# AI_SIDECAR_INJECT_UCI=e8e1
